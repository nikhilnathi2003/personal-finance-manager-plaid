PORT=4000

# Plaid — from dashboard.plaid.com → Team Settings → Keys.
# Start with the sandbox secret + PLAID_ENV=sandbox to test, then
# switch to your production secret + PLAID_ENV=production for real banks.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox

# Google AI Studio (aistudio.google.com/app/apikey) — only needed for
# the AI Insights tab. Everything else works without it.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: where the local data file lives (defaults to ./data/store.json)
# DATA_FILE=./data/store.json
